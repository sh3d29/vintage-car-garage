{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "args": ["dev"],
      "cwd": "${workspaceFolder}/server"
    },
    {
      "name": "ReactRouter Debugger",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client"
    }
  ]
}
